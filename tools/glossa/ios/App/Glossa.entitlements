<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Κοινές ρυθμίσεις ανάμεσα σε εφαρμογή και πληκτρολόγιο. -->
    <key>com.apple.security.application-groups</key>
    <array>
        <string>group.gr.a2l.glossa</string>
    </array>

    <!-- Κοινά κλειδιά. Όταν ο κώδικας δεν δηλώνει ρητά ομάδα, το iOS
         χρησιμοποιεί την ΠΡΩΤΗ αυτής της λίστας — γι' αυτό αρκεί να είναι
         ίδια και στους δύο στόχους, χωρίς να χρειάζεται ο κώδικας να ξέρει
         το πρόθεμα της ομάδας ανάπτυξης. -->
    <key>keychain-access-groups</key>
    <array>
        <string>$(AppIdentifierPrefix)gr.a2l.glossa</string>
    </array>
</dict>
</plist>
